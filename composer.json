{
    "name": "dandrum/livewire-pagebuilder",
    "description": "Laravel Livewire block-based content builder (paragraph/heading/image/image+text blocks stored as JSON)",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Dandrum\\PageBuilder\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dandrum\\PageBuilder\\Tests\\": "tests"
        }
    },
    "authors": [
        {
            "name": "Daniel",
            "email": "daniel.schmidt89@freenet.de"
        }
    ],
    "scripts": {
        "format": "vendor/bin/pint",
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dandrum\\PageBuilder\\Providers\\PageBuilderServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ezyang/htmlpurifier": "^4.17",
        "illuminate/support": "^11|^12|^13",
        "livewire/livewire": "^3|^4"
    },
    "require-dev": {
        "laravel/pint": "^1",
        "orchestra/testbench": "^9|^10|^11",
        "phpunit/phpunit": "^11|^12"
    }
}
